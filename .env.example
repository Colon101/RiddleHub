# Copy to the repository root as `.env`, which is outside the RiddleHub web
# root. Keep the file untracked and mode 0600. Values are deliberately empty:
# generate unique secrets of at least 16 characters for each deployment and never reuse them.

RIDDLEHUB_ADMIN_PASSWORD=
RIDDLEHUB_SQL_PASSWORD=

# Optional connection profile override.
RIDDLEHUB_CONNECTION_NAME=LinuxSqlServerDev
