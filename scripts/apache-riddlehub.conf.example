# Development-only Apache + mod_mono site for RiddleHub.
# The application listener is intentionally loopback-only. For remote access,
# terminate TLS in a separate production vhost/reverse proxy as described in
# docs/SECURE_DEPLOYMENT.md.

# LoadModule mono_module modules/mod_mono.so
# Include conf/extra/riddlehub.conf

Listen 127.0.0.1:8080

<VirtualHost 127.0.0.1:8080>
    ServerName localhost
    DocumentRoot "/workspace/RiddleHub/RiddleHub"

    MonoServerPath riddlehub "/usr/bin/mod-mono-server4"
    MonoApplications riddlehub "/:/workspace/RiddleHub/RiddleHub"
    MonoSetEnv riddlehub RIDDLEHUB_CONNECTION_NAME=LinuxSqlServerDev

    <Directory "/workspace/RiddleHub/RiddleHub">
        Options -Indexes
        AllowOverride None
        Require all granted

        # Defense in depth for dotfiles such as an accidentally copied .env.
        <FilesMatch "^\.">
            Require all denied
        </FilesMatch>
    </Directory>

    # ASP.NET also blocks these directories, but Apache should never serve them.
    <LocationMatch "^/(?:App_Data|bin|obj)(?:/|$)">
        Require all denied
    </LocationMatch>

    AddType application/x-asp-net .aspx .ashx .asmx .ascx
</VirtualHost>
